# GhostClean environment template — PLACEHOLDERS ONLY. Never real secrets.
# Copy to .env (git-ignored) and fill locally:
#   copy .env.example .env   (Windows)  /  cp .env.example .env  (macOS/Linux)
#
# Generate a local token-encryption key with:
#   python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"

# --- Database (local Compose defaults; override as needed) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/ghostclean
DATABASE_NAME=ghostclean
DATABASE_USERNAME=ghostclean
DATABASE_PASSWORD=changeme-local-only
DATABASE_PORT=5432

# --- Redis (local) ---
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# Host/port the API uses for Redis. The limiter only dials Redis when
# RATE_LIMITER_BACKEND=redis (Phase 11, fail-closed when unreachable).
REDIS_HOST=localhost
# --- Phase 11 rate limiting (placeholders only) ---
# memory (default, single-instance) or redis (distributed, fail-closed).
# RATE_LIMITER_BACKEND=memory

# --- App ---
APP_PORT=8080
SPRING_PROFILES_ACTIVE=
# Local SPA/API base (host port). Local GhostClean override: 8082.
# Production: https://api.ghostclean.com (no code changes required).
APP_BASE_URL=http://localhost:8080
APP_REGION=eu
# Production edge trust (ADR-034, Phase 12): comma-separated IPs/CIDRs of
# the managed TLS edge allowed to supply forwarded client info. Empty =
# trust nothing beyond the direct connection. Placeholder only.
# TRUSTED_PROXIES=

# --- Google connection approval admins (placeholders only) ---
# Verified owners of these comma-separated addresses may approve Google
# connection requests; everyone else receives 403. Notification address
# defaults to the first entry. Set ONLY in local .env (never commit).
# ADMIN_EMAILS=you@example.com
# ADMIN_NOTIFICATION_EMAIL=you@example.com

# --- Local token encryption (placeholders only) ---
# Local/dev/test use provider=env with TOKEN_ENCRYPTION_KEY below.
# TOKEN_CRYPTO_PROVIDER=env

# --- Security (REQUIRED, no default — app fails fast without it) ---
# 32 random bytes, Base64-encoded. Placeholder only:
TOKEN_ENCRYPTION_KEY=REPLACE_ME_with_32_random_bytes_base64
# Access-token signing secret, min 32 characters (48+ random bytes recommended).
# Generate locally with a CSPRNG, e.g. PowerShell:
#   $r = [System.Security.Cryptography.RandomNumberGenerator]::Create()
#   $b = New-Object byte[] 48; $r.GetBytes($b); [Convert]::ToBase64String($b)
# Placeholder only:
JWT_SIGNING_KEY=REPLACE_ME_with_a_long_random_signing_key_min_32_chars

# --- Phase 2 authentication tuning (all optional, defaults apply) ---
# Local http development must disable Secure cookies; production keeps true.
AUTH_COOKIE_SECURE=false
# Verification-mail mode: silent (default, nothing logged) or log (local dev
# only — NEVER in production). No external provider is configured in Phase 2.
VERIFICATION_MAIL_MODE=log
# Optional lifetime overrides (defaults: 15m access, 30d refresh, 24h verify):
# AUTH_ACCESS_TOKEN_TTL=15m
# AUTH_REFRESH_TOKEN_TTL=30d
# AUTH_VERIFICATION_TOKEN_TTL=24h

# --- Transactional verification mail (ADR-038, placeholders only) ---
# Empty provider (default) keeps Phase 2 silent/log behavior: no network.
# Production: verify a sender/domain in Resend, then set these ONLY in local
# .env (never commit), recreate the api service, and register. See
# docs/TRANSACTIONAL_EMAIL_SETUP.md. NEVER put a real key here.
# EMAIL_PROVIDER=resend
# EMAIL_FROM=verify@mail.ghostclean.com
# EMAIL_FROM_NAME=GhostClean
# EMAIL_API_KEY=
# EMAIL_API_BASE_URL=https://api.resend.com
# EMAIL_TIMEOUT_MS=8000
# Gmail SMTP alternative: set EMAIL_PROVIDER=gmail with the Gmail address
# as sender and an App Password ONLY in local .env (never commit, never
# share). The Gmail account must have 2-Step Verification enabled to create
# an App Password. Recipient is always the registering user's address.
# EMAIL_PROVIDER=gmail
# EMAIL_FROM=you@gmail.com
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=you@gmail.com
# EMAIL_SMTP_PASSWORD=
# (EMAIL_USERNAME/EMAIL_PASSWORD are accepted as fallback names.)
# EMAIL_TIMEOUT_MS=8000

# --- OAuth (Phase 3+. Placeholders only. NO real credentials. Do NOT fill
# --- with production client ids/secrets; those live in a secret manager.)
# OAUTH_GOOGLE_CLIENT_ID=your-google-client-id-placeholder
# OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret-placeholder
# OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8082/api/v1/oauth/google/callback
# OAUTH_MS_CLIENT_ID=your-microsoft-client-id-placeholder
# OAUTH_MS_CLIENT_SECRET=your-microsoft-client-secret-placeholder
# OAUTH_MS_REDIRECT_URI=http://localhost:8080/api/v1/oauth/microsoft/callback

# --- Google OAuth, Phase 4 (identity + mailbox read).
# --- Empty client values by default; the app answers authorize with a safe
# --- provider error until you configure your own Google Cloud OAuth client
# --- (see docs/GOOGLE_OAUTH_SETUP.md). NEVER commit real values.
# --- Local redirect uses the host port (8082 -> container 8080).
# --- Production (no code change): GOOGLE_REDIRECT_URI=https://api.ghostclean.com/api/v1/oauth/google/callback
# --- with APP_BASE_URL=https://api.ghostclean.com in the prod environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8082/api/v1/oauth/google/callback
# Mailbox read scope requested at authorize time (restricted scope — Google
# verification/security assessment required before public production use).
# Existing identity-only connections must reconnect to grant it.
GOOGLE_MAILBOX_SCOPE=https://www.googleapis.com/auth/gmail.readonly

# --- Microsoft OAuth + Graph, Phase 10 (delegated identity + mailbox read).
# --- Empty client values by default; the app answers authorize with a safe
# --- provider error until you configure your own Entra app registration
# --- (see docs/MICROSOFT_OAUTH_SETUP.md). NEVER commit real values.
# --- (The commented OAUTH_MS_* lines above were early placeholders;
# --- MICROSOFT_* below are the canonical Phase 10 variable names.)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8080/api/v1/oauth/microsoft/callback
# Entra authority tenant (default "common"); Graph base override (optional).
# MICROSOFT_TENANT=common
# MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com
# Mailbox read scope requested at authorize time (delegated Mail.Read —
# Microsoft publisher verification NOT complete; testing tenants only).
# Existing connections granted without it must reconnect to grant it.
MICROSOFT_MAILBOX_SCOPE=https://graph.microsoft.com/Mail.Read

# --- Phase 4 scan budgets (all optional, defaults apply) ---
# GMAIL_MAX_MESSAGES_PER_SCAN=500
# GMAIL_LOOKBACK_MONTHS=12

# --- Phase 10 Graph scan budgets (all optional, defaults apply) ---
# GRAPH_MAX_MESSAGES_PER_SCAN=500
# GRAPH_LOOKBACK_MONTHS=12

# --- Phase 7 outbound dispatch (placeholders only; default provider is the
# --- in-memory sink, which never sends real email. No real credentials here.)
# OUTBOUND_MAIL_PROVIDER=sink
# OUTBOUND_MAIL_FROM=privacy-requests@example.invalid
# OUTBOUND_MAIL_API_KEY=
# OUTBOUND_MAIL_MAX_ATTEMPTS=3

# --- Phase 13 ML/AI scorer (Bedrock, ADR-037. Placeholders only.) ---
# Optional additive scorer behind detection.ml.enabled; default OFF keeps the
# deterministic rule engine as the sole scorer with no Bedrock network call.
# The API key is a SHORT-TERM Bedrock key from the environment only — NEVER
# commit a real key; REPLACE_ME stays as the placeholder.
# DETECTION_ML_ENABLED=false
# BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
# BEDROCK_MODEL=qwen.qwen3-coder-480b-a35b-instruct
# BEDROCK_API_KEY=REPLACE_ME_with_short_term_bedrock_key
# BEDROCK_TIMEOUT_MS=8000

# --- Edge proxy (optional) ---
NGINX_PORT=8081
