# GhostClean frontend environment.
#
# Copy to `.env` for local development. The dev server proxies `/api` to the
# backend, so this file is only needed for production builds served from a
# different origin than the API.
#
# Base URL of the GhostClean Spring Boot API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8082
#
# WARNING: anything starting with VITE_ is embedded in the browser bundle and
# is PUBLIC. Never put backend secrets here: no database passwords, no JWT
# signing secret, no OAuth client secrets, no encryption keys, no API keys,
# no refresh tokens.
